
{
  "name": "ADA — Network Audit",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ada-network-audit",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook ADA",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "command": "nmap -sn 192.168.10.0/24 -oG - | awk '/Up$/{print $2, $3}'"
      },
      "id": "exec-nmap",
      "name": "Scan réseau",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.stdout || '';\n\nconst hosts = [];\nconst lines = raw.trim().split('\\n').filter(l => l.length > 0);\n\nfor (const line of lines) {\n  const parts = line.trim().split(' ');\n  const ip = parts[0] || '';\n  const hostname = parts[1] ? parts[1].replace(/[()]/g, '') : '';\n  if (ip) {\n    hosts.push({ ip, hostname: hostname || null });\n  }\n}\n\nconst now = new Date().toISOString();\n\nreturn [{\n  json: {\n    event_id: 'evt_netaudit_' + Date.now(),\n    event_type: 'network.audit_completed',\n    source: 'n8n',\n    target: 'ada',\n    timestamp: now,\n    idempotency_key: 'netaudit_' + Date.now(),\n    payload: {\n      subnet: '192.168.10.0/24',\n      host_count: hosts.length,\n      hosts: hosts\n    },\n    metadata: {\n      workflow_name: 'ada_network_audit',\n      scanner: 'nmap'\n    }\n  }\n}];\n"
      },
      "id": "format-results",
      "name": "Formater résultats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.10.172:7654/api/integrations/n8n/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-ADA-Source",
              "value": "n8n"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "send-ada",
      "name": "Envoyer à ADA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"ok\", \"message\": \"Audit lancé\", \"host_count\": $('Formater résultats').first().json.payload.host_count } }}",
        "options": {}
      },
      "id": "webhook-response",
      "name": "Réponse webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, 300]
    }
  ],
  "connections": {
    "Webhook ADA": {
      "main": [
        [
          {
            "node": "Scan réseau",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Scan réseau": {
      "main": [
        [
          {
            "node": "Formater résultats",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Formater résultats": {
      "main": [
        [
          {
            "node": "Envoyer à ADA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Envoyer à ADA": {
      "main": [
        [
          {
            "node": "Réponse webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "pinData": {}
}
